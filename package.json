{
  "name": "mcode-monorepo",
  "private": true,
  "version": "2.4.6",
  "description": "mcode — terminal-first, multi-model AI coding CLI (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "mcode": "node packages/cli/bin/mcode.js",
    "dev:cli": "node --watch packages/cli/bin/mcode.js",
    "dev:web": "npm --workspace=web run dev",
    "dev:dashboard": "npm --workspace=web run dev",
    "dev:backend": "npm --workspace=@mcode/backend run dev",
    "serve": "node packages/cli/bin/mcode.js serve",
    "build:cli": "node packages/cli/scripts/build.js",
    "build:web": "npm --workspace=web run build",
    "test": "vitest run",
    "test:all": "vitest run && npm --workspace=web run test",
    "coverage": "vitest run --coverage",
    "seed": "node scripts/seed-dev-data.mjs",
    "lint": "eslint packages/cli/src packages/shared/src packages/backend/src",
    "typecheck": "tsc -p packages/shared/tsconfig.json",
    "build": "npm run build:cli && npm run build:web",
    "lint:web": "npm --workspace=web run lint",
    "publish:cli": "npm run build:cli && npm publish ./packages/cli",
    "postinstall": "node scripts/bootstrap.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint-plugin-react": "^7.37.5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "esbuild": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true
  }
}
