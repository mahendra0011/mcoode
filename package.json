{
  "name": "mcode-monorepo",
  "private": true,
  "version": "2.4.6",
  "description": "mcode — terminal-first, multi-model AI coding CLI (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "mcode": "node packages/cli/bin/mcode.js",
    "dev:cli": "node --watch packages/cli/bin/mcode.js",
    "dev:web": "npm --workspace=web run dev",
    "dev:dashboard": "npm --workspace=web run dev",
    "dev:backend": "npm --workspace=@mcode/backend run start",
    "serve": "node packages/cli/bin/mcode.js serve",
    "build:cli": "node packages/cli/scripts/build.js",
    "build:web": "npm --workspace=web run build",
    "test": "vitest run",
    "lint": "eslint packages --ext .js,.jsx",
    "publish:cli": "npm run build:cli && npm publish ./packages/cli",
    "postinstall": "node scripts/bootstrap.js"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "esbuild": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true
  }
}
