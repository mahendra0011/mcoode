{
  // SHR-005: type gate for the contracts package — JSDoc-checked JS.
  // Lenient by design (noImplicitAny off): catches undefined names, bad
  // imports/exports and arity bugs without demanding full annotations.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js"]
}
