{
  "name": "mcode-cli",
  "version": "2.4.6",
  "description": "Terminal-first, multi-model AI coding CLI. Bring your own model keys and let subagents build, fix and watch your project.",
  "type": "module",
  "main": "dist/mcode.mjs",
  "exports": {
    ".": "./dist/mcode.mjs",
    "./orchestrator": "./src/core/orchestrator.js",
    "./chat-agent": "./src/core/chat-agent.js",
    "./tools": "./src/core/tools.js",
    "./router": "./src/core/router.js",
    "./providers": "./src/providers/index.js",
    "./planner": "./src/core/planner.js",
    "./browser-tool": "./src/core/browser-tool.js"
  },
  "bin": {
    "mcode": "bin/mcode.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "start": "node bin/mcode.js",
    "build": "node scripts/build.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "cli-boxes": "^4.0.0",
    "cli-highlight": "^2.1.11",
    "commander": "^13.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "execa": "^9.5.2",
    "gradient-string": "^3.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "simple-git": "^3.27.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
