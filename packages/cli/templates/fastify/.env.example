# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# shell: cp .env.example .env

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS: comma-separated allowlist. Empty = same-origin only (no CORS headers).
CORS_ORIGIN=

# Rate limit: requests per time window per IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Secrets — keep out of git, prefer `mcode env add <KEY> <value>` (encrypted vault)
# DATABASE_URL=
# JWT_SECRET=
# API_KEY_ENCRYPTION_SECRET=
