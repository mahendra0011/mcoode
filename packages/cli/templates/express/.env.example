# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# shell: cp .env.example .env

PORT=3000
NODE_ENV=development

# CORS: comma-separated allowlist. Empty = same-origin only (no CORS headers).
CORS_ORIGIN=

# Global rate limit: requests per window per IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Secrets — keep out of git, prefer `mcode env add <KEY> <value>` (encrypted vault)
# DATABASE_URL=
# JWT_SECRET=
# API_KEY_ENCRYPTION_SECRET=
