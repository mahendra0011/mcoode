# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# shell: cp .env.example .env

# API server
PORT=3000
NODE_ENV=development

# Vite dev-server port + public API URL (VITE_* is browser-visible: no secrets)
VITE_PORT=5173
VITE_API_URL=http://localhost:3000

# CORS: comma-separated allowlist. Empty = same-origin only (no CORS headers).
CORS_ORIGIN=

# Rate limit: requests per window per IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Secrets — keep out of git, prefer `mcode env add <KEY> <value>` (encrypted vault)
# DATABASE_URL=
# JWT_SECRET=
# API_KEY_ENCRYPTION_SECRET=
