# Backend environment variables
# Copy this file to .env and fill in real values.

# --- Web search (used by web_search / web_fetch tools in chat mode) ---
# Without this, the app falls back to scraping DuckDuckGo Lite, which is
# fragile and frequently returns "No search results found" when DDG
# changes its HTML or rate-limits the request. Get a free key (1000
# searches/month) at https://tavily.com — strongly recommended.
TAVILY_API_KEY=

# --- GitHub OAuth (for "Sign in with GitHub" / GitHub connector) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=development
