# Backend environment variables
# Copy this file to .env and fill in real values.

# --- Required ---
JWT_SECRET=change-me-to-a-long-random-string
MONGODB_URI=mongodb://localhost:27017/mcode
PORT=3100
NODE_ENV=development

# --- Optional (caching / jobs / mail) ---
REDIS_URI=
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=mcode
PISTON_URL=http://localhost:2000
MCODE_MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3100

# --- Web search (built-in custom engine using DuckDuckGo + Bing scraper) ---
# No third-party API key required.


# --- GitHub OAuth (for "Sign in with GitHub" / GitHub connector) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3100/api/v1/auth/github/callback
