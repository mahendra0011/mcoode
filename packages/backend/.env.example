# Backend environment variables
# Copy this file to .env and fill in real values.

# --- Web search (built-in custom engine using DuckDuckGo + Bing scraper) ---
# No third-party API key required.


# --- GitHub OAuth (for "Sign in with GitHub" / GitHub connector) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=development
