# ─── mcode environment variables template ──────────────────────────────────
# Copy this file to .env and fill in real values. Do NOT commit .env to git.

# JWT (auth tokens) — use a strong 32+ character random secret
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here

# MongoDB Atlas or Local connection string
MONGODB_URI=mongodb://localhost:27017/mcode

# Brevo (email OTP) — optional in local development
BREVO_API_KEY=
MAIL_FROM=no-reply@mcode.dev
MAIL_FROM_NAME=mcode

# Server
PORT=3100
LOG_LEVEL=info
NODE_ENV=development

# Piston Sandbox API
PISTON_URL=http://localhost:2000

# CLI → backend socket auth (SEC-008) — set the SAME value in backend .env.
# When set, unauthenticated socket emitters cannot broadcast build/watch events.
CLI_SHARED_SECRET=

# Local vault master password (SEC-003) — optional but STRONGLY recommended.
# When set, the CLI vault key requires this in addition to machine identity.
MCODE_VAULT_PASSWORD=

# Redis (Optional)
REDIS_URI=
