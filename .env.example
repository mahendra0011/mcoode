# ─── mcode environment variables template ──────────────────────────────────
# Copy this file to .env and fill in real values. Do NOT commit .env to git.

# JWT (auth tokens) — use a strong 32+ character random secret
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here

# At-rest encryption for stored provider API keys + GitHub OAuth tokens (BSEC-001).
# MUST differ from JWT_SECRET: the JWT secret signs short-lived tokens, this one
# encrypts long-lived secrets in MongoDB. Rotation: set the new value here and
# keep the old one as API_KEY_ENCRYPTION_SECRET_PREVIOUS (+ its keyId) until all
# rows are re-encrypted (happens lazily on keys GET). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_min_32_chars_random_here
# Optional keyId label for new writes (default: ek1). Change when rotating secrets.
API_KEY_ENCRYPTION_KEY_ID=
# Previous secret kept read-only during rotation (plus its keyId, default: ek0).
API_KEY_ENCRYPTION_SECRET_PREVIOUS=
API_KEY_ENCRYPTION_PREVIOUS_KEY_ID=

# MongoDB Atlas or Local connection string
MONGODB_URI=mongodb://localhost:27017/mcode

# Brevo (email OTP) — optional in local development
BREVO_API_KEY=
MAIL_FROM=no-reply@mcode.dev
MAIL_FROM_NAME=mcode

# Server
PORT=3100
LOG_LEVEL=info
NODE_ENV=development

# Piston Sandbox API
PISTON_URL=http://localhost:2000

# CLI → backend socket auth (SEC-008) — set the SAME value in backend .env.
# When set, unauthenticated socket emitters cannot broadcast build/watch events.
CLI_SHARED_SECRET=

# Local vault master password (SEC-003) — optional but STRONGLY recommended.
# When set, the CLI vault key requires this in addition to machine identity.
MCODE_VAULT_PASSWORD=

# Redis (Optional)
REDIS_URI=
